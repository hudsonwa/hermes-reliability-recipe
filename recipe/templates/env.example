# Copy to ~/.hermes/profiles/<PROFILE>/.env and fill values
# NEVER commit real .env
# HUMAN fills secrets — agents must not invent tokens.

# Model provider keys (use what your setup needs)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional messaging
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_THREAD_ID=

# Optional API server
API_SERVER_ENABLED=false
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=
API_SERVER_MODEL_NAME=
